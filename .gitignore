# Ignore all private key and certificate files (recommended)
**/*.pem
**/*.csv


# ---------------------------------------------------------
# UNIVERSAL / MULTI-TECH IGNORE RULES (ADDED BELOW)
# ---------------------------------------------------------

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Node dependencies
**/node_modules/

# Python environments
**/venv/
**/.venv/
**/env/
**/.env/

# Python cache
*.pyc
__pycache__/
.pytest_cache/
.ipynb_checkpoints/

# Java / Spring Boot
**/target/
**/build/
**/.gradle/
**/.mvn/
*.class

# Maven
**/pom.xml.tag
**/pom.xml.releaseBackup
**/pom.xml.versionsBackup
**/pom.xml.next

# Gradle wrapper/working
**/gradle/
**/gradlew.bat
**/gradlew

# Logs
**/*.log
**/log/
**/logs/

# Frontend build outputs
**/dist/
**/out/
**/.next/
**/.nuxt/
**/.vite/
**/.parcel-cache/
**/.turbo/
**/.svelte-kit/

# Cache
**/.cache/

# Environment files (security)
*.env
*.env.*
**/*.env

# Certificates & keys (your rule already covers PEM)
**/*.key
**/*.crt

# GCP service-account JSON keys — never commit these
**/*-key.json
**/*-sa-key.json
**/service-account*.json
**/gcp-credentials*.json
github-actions-key.json
**/application_default_credentials.json
**/client_secret*.json

# Other cloud / cluster credentials
**/.aws/credentials
**/.gcloud/
**/kubeconfig
**/*.kubeconfig
**/*.p12
**/*.pfx
**/*.jks

# Docker
**/.docker/
**/.dockerignore~

# Kubernetes autogenerated files (keep manifests)
**/kustomize-build/
**/.kube/

# Test coverage
**/coverage/
**/.nyc_output/
**/junit-report.xml

# IDE Files
# VSCode
**/.vscode/
!**/.vscode/settings.json

# JetBrains
**/.idea/

# Eclipse
**/.project
**/.classpath
**/.settings/

# Package managers logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Misc build artifacts
*.o
*.so
*.dll
*.exe

# Terraform
# .terraform/ holds downloaded provider binaries (hundreds of MB) - never commit
**/.terraform/
# State files can contain plaintext secrets and must not be committed
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
# Saved plan files are zip archives containing full resource values
tfplan
*.tfplan
# CLI config can hold registry credentials
.terraformrc
terraform.rc
# Local overrides are machine-specific by design
override.tf
override.tf.json
*_override.tf
*_override.tf.json
crash.log
crash.*.log
# Keep the dependency lock file - it is meant to be committed
!.terraform.lock.hcl
